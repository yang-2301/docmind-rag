# Copy to .env and fill in what you have. Everything is optional —
# without keys the app runs fully offline using the built-in embedding
# and extractive answering.

# --- LLM answering (optional) ---
# Without a key the API returns an extractive answer built from the
# top-ranked passages, clearly labelled as such.
OPENAI_API_KEY=
DOCMIND_LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
# lsa       : built-in TF-IDF + SVD, no downloads (default)
# openai    : text-embedding-3-small, requires OPENAI_API_KEY
# minilm    : sentence-transformers all-MiniLM-L6-v2, requires the package
DOCMIND_EMBEDDER=lsa
DOCMIND_EMBED_MODEL=text-embedding-3-small

# --- Retrieval ---
DOCMIND_TOP_K=8
DOCMIND_RERANK=1

# --- Grounding gate ---
# Minimum fraction of the question's content terms that must appear in the
# union of the top passages before any answer is generated. On the bundled
# golden set the lowest legitimate question scores 0.33, while unrelated
# questions peak at 0.25 — hence 0.30. Raise it for stricter refusals, and
# re-run `make eval` plus the test suite after changing it.
DOCMIND_MIN_COVERAGE=0.30
